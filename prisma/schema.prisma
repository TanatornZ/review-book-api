generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books   Book[]   @relation("BookAuthor")
  reviews Review[]
}

model Book {
  id          String    @id @default(uuid())
  title       String
  authorName  String
  description String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String

  createdBy User @relation("BookAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  reviews   Review[]

  @@index([createdById])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  bookId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Each user can submit one review per book.
  @@unique([bookId, userId])
  @@index([bookId])
  @@index([userId])
}
